# Copy to .env in the repository root. Fill only the providers you use.
# GPT6_SOL also configures the default text answer extractor.
# Dataset image downloads need no AWS credentials.

GPT6_SOL_BASE_URL=
GPT6_SOL_API_KEY=
GPT6_SOL_MODEL=gpt-6-sol

GPT6_LUNA_BASE_URL=
GPT6_LUNA_API_KEY=
GPT6_LUNA_MODEL=gpt-6-luna

GPT6_ASTRA_BASE_URL=
GPT6_ASTRA_API_KEY=
GPT6_ASTRA_MODEL=gpt-6-astra

OPUS55_API_KEY=
OPUS55_REGION=
OPUS55_MODEL=global.anthropic.claude-opus-5-5

SONNET55_API_KEY=
SONNET55_REGION=
SONNET55_MODEL=global.anthropic.claude-sonnet-5-5

MUSE_BASE_URL=
MUSE_API_KEY=
MUSE_MODEL=meta/muse-spark-1.3-contributor

GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=z-ai/glm-5.3-flash

DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash

# Additional model configurations.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROK_MODEL=x-ai/grok-4.6

# Bedrock models accept standard AWS credentials or AWS_BEARER_TOKEN_BEDROCK.
# Opus and Sonnet also accept their model-specific API keys above.
FABLE_REGION=us-east-1
FABLE_MODEL=global.anthropic.claude-fable-5-1
